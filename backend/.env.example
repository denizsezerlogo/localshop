# Sunucu
PORT=3000
NODE_ENV=development

# Veritabanı
MONGO_URI=mongodb://127.0.0.1:27017/localshop

# JWT (uzun, rastgele bir değer kullanın: openssl rand -hex 32)
JWT_SECRET=buraya-uzun-rastgele-bir-deger-yazin
JWT_EXPIRES_IN=7d

# CORS — yalnızca bu origin'e izin verilir (frontend adresi)
CLIENT_URL=http://localhost:5173
